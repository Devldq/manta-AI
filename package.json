{
  "name": "manta",
  "version": "2.0.0",
  "private": true,
  "author": "lidaqing",
  "description": "Manta — Agent 调度操作系统 · Humans steer. Agents execute. Drivers are pluggable.",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:fe": "pnpm exec turbo run dev --filter=@manta/frontend",
    "dev:be": "pnpm exec turbo run dev --filter=@manta/backend",
    "dev:desktop": "pnpm exec turbo run dev --filter=@manta/desktop",
    "build": "pnpm exec turbo run build --filter=@manta/contracts --filter=@manta/task-runtime --filter=@manta/shared --filter=@manta/storage-hub --filter=@manta/rag --filter=@manta/agent-sandbox --filter=@manta/skill-runtime --filter=@manta/backend --filter=@manta/service --filter=@manta/sdk --filter=@manta/cli --filter=@manta/mcp-server --filter=@manta/a2a-server --filter=@manta/frontend --filter=@manta/desktop",
    "build:docker": "docker compose -f docker/docker-compose.yml build",
    "start:docker": "docker compose -f docker/docker-compose.yml up",
    "start": "pnpm --filter @manta/service start",
    "typecheck": "pnpm exec turbo run typecheck --filter=@manta/contracts --filter=@manta/task-runtime --filter=@manta/shared --filter=@manta/storage-hub --filter=@manta/rag --filter=@manta/agent-sandbox --filter=@manta/skill-runtime --filter=@manta/backend --filter=@manta/service --filter=@manta/sdk --filter=@manta/cli --filter=@manta/mcp-server --filter=@manta/a2a-server --filter=@manta/frontend --filter=@manta/desktop",
    "test": "pnpm test:dev && pnpm exec turbo run test --concurrency=1",
    "test:dev": "node --test scripts/start-dev.test.cjs",
    "lint": "pnpm exec turbo run lint",
    "storage:audit": "pnpm storage:audit:test && node scripts/security/ash-storage-audit.ts",
    "storage:audit:test": "node scripts/security/ash-storage-audit.test.cjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "verify:ash:phase1": "node scripts/verify/ash-phase1.ts",
    "verify:ash:phase2": "node scripts/verify/ash-phase2.ts",
    "verify:ash:phase3": "node scripts/verify/ash-phase3.ts",
    "clean": "pnpm exec turbo run clean"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@parcel/watcher",
      "esbuild",
      "electron",
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
