{
  "name": "@manta/backend",
  "version": "2.0.0",
  "description": "Compatibility runtime used by the desktop-only Manta local service",
  "type": "module",
  "main": "./dist/server.cjs",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.cjs",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist/server.cjs",
    "dist/**/*.d.ts",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-runtime.cjs",
    "dev": "tsx watch -r tsconfig-paths/register src/server.ts",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json --coverage.exclude=**/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.96",
    "@ai-sdk/openai": "^3.0.63",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.2",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@manta/agent-sandbox": "workspace:*",
    "@manta/contracts": "workspace:*",
    "@manta/rag": "workspace:*",
    "@manta/shared": "workspace:*",
    "@manta/skill-runtime": "workspace:*",
    "@manta/storage-hub": "workspace:*",
    "@manta/task-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.177",
    "better-sqlite3": "12.11.1",
    "fastify": "^5.3.3",
    "js-yaml": "^4.1.0",
    "proper-lockfile": "^4.1.2",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "0.27.4",
    "pino-pretty": "^13.1.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Devldq/manta-AI.git",
    "directory": "packages/backend"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
