{
  "name": "@manta/sdk",
  "version": "0.1.0",
  "description": "OpenAI-style TypeScript client for the local Manta desktop service",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm,cjs --dts --splitting false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@manta/contracts": "workspace:*",
    "@manta/service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Devldq/manta-AI.git", "directory": "packages/sdk" },
  "publishConfig": { "access": "public", "provenance": true }
}
