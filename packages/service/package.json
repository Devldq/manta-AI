{
  "name": "@manta/service",
  "version": "0.1.0",
  "description": "Desktop-only local Manta API and worker service",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "manta-service": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts && tsup src/cli.ts --format esm --no-dts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@manta/backend": "workspace:*",
    "@manta/shared": "workspace:*",
    "@manta/storage-hub": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Devldq/manta-AI.git", "directory": "packages/service" },
  "publishConfig": { "access": "public", "provenance": true }
}
