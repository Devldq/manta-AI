{
  "name": "@manta/storage-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "pnpm build && vitest run --coverage --coverage.reporter=json --coverage.reporter=text-summary",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit && tsc -p test/fixtures/tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@manta/shared": "workspace:*",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
