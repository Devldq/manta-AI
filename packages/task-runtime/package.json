{
  "name": "@manta/task-runtime",
  "version": "0.1.0",
  "description": "Durable local job runtime for Manta workers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@manta/contracts": "workspace:*",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Devldq/manta-AI.git", "directory": "packages/task-runtime" },
  "publishConfig": { "access": "public", "provenance": true }
}
