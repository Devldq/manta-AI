{
  "name": "@manta/rag",
  "version": "0.1.0",
  "description": "UI-free Manta RAG parsing, chunking, indexing and retrieval engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./qdrant": {
      "import": { "types": "./dist/qdrant.d.ts", "default": "./dist/qdrant.js" },
      "require": { "types": "./dist/qdrant.d.cts", "default": "./dist/qdrant.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/qdrant.ts --format esm,cjs --dts --splitting false",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json --coverage.exclude=**/*.test.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "1.18.0",
    "better-sqlite3": "^12.11.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5",
    "tsup": "^8.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Devldq/manta-AI.git", "directory": "packages/rag" },
  "publishConfig": { "access": "public", "provenance": true }
}
