{
  "name": "@manta/desktop",
  "version": "2.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron dist/main.js",
    "build": "node scripts/clean.cjs && tsc && node scripts/copy-assets.cjs",
    "prepare-packaged-runtime": "node scripts/prepare-packaged-runtime.cjs",
    "package:dir": "pnpm build && pnpm prepare-packaged-runtime && node scripts/package-smoke.cjs --prepared",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:win": "pnpm build && pnpm prepare-packaged-runtime && node scripts/build-win.cjs && node scripts/package-smoke.cjs --prepared",
    "build:linux": "pnpm build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "test:clean": "node --test scripts/clean.test.cjs",
    "test:e2e:ash": "pnpm --filter @manta/frontend build && pnpm build && vitest run --config vitest.e2e.config.ts",
    "test": "pnpm test:clean && vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json --coverage.exclude=**/*.test.ts --coverage.exclude=**/dist/** --coverage.exclude=**/.package-staging/** --coverage.exclude=**/release/** --coverage.exclude=**/release-*/** --coverage.exclude=**/coverage/**"
  },
  "dependencies": {
    "@manta/backend": "workspace:*",
    "@manta/shared": "workspace:*",
    "@manta/storage-hub": "workspace:*",
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "4.2.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "esbuild": "0.27.4",
    "fake-indexeddb": "6.2.2",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
